<launch>
  <node name="astar_grid_planner" pkg="grid_path_planner" type="astar_planner.py" output="screen">
    <param name="grid_width" value="30" />
    <param name="grid_height" value="30" />
    <param name="resolution" value="1.0" />
    <rosparam param="start">[0, 0]</rosparam>
    <rosparam param="goal">[29, 29]</rosparam>
  </node>

  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find grid_path_planner)/rviz/config.rviz" required="false" />
</launch>
