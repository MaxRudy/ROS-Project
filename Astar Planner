#!/usr/bin/env python3
"""
A* Grid-Based Path Planning Node for ROS.

Plans a path on a 2D occupancy grid using the A* search algorithm,
then publishes:
  - /planned_path   (nav_msgs/Path)              -> the final path
  - /planning_markers (visualization_msgs/MarkerArray) -> obstacles,
    path line, start sphere, goal sphere, and a moving agent marker.
"""

import rospy
import heapq
from nav_msgs.msg import Path
from geometry_msgs.msg import PoseStamped, Point
from visualization_msgs.msg import Marker, MarkerArray


class GridMap:
    """A simple 2D grid with a set of blocked (obstacle) cells."""

    def __init__(self, width, height, resolution, obstacles):
        self.width = width
        self.height = height
        self.resolution = resolution
        self.obstacles = set(map(tuple, obstacles))

    def in_bounds(self, cell):
        x, y = cell
        return 0 <= x < self.width and 0 <= y < self.height

    def is_free(self, cell):
        return cell not in self.obstacles

    def neighbors(self, cell):
        x, y = cell
        candidates = [
            (x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1),
            (x + 1, y + 1), (x - 1, y - 1),
            (x + 1, y - 1), (x - 1, y + 1),
        ]
        return [c for c in candidates if self.in_bounds(c) and self.is_free(c)]


def heuristic(a, b):
    return ((a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2) ** 0.5


def move_cost(a, b):
    return 1.4142 if (a[0] != b[0] and a[1] != b[1]) else 1.0


def astar(grid, start, goal):
    open_heap = []
    heapq.heappush(open_heap, (0.0, start))
    open_set = {start}

    came_from = {}
    g_score = {start: 0.0}

    while open_heap:
        _, current = heapq.heappop(open_heap)
        open_set.discard(current)

        if current == goal:
            return _reconstruct_path(came_from, current)

        for neighbor in grid.neighbors(current):
            tentative_g = g_score[current] + move_cost(current, neighbor)

            if tentative_g < g_score.get(neighbor, float('inf')):
                came_from[neighbor] = current
                g_score[neighbor] = tentative_g
                f = tentative_g + heuristic(neighbor, goal)
                if neighbor not in open_set:
                    heapq.heappush(open_heap, (f, neighbor))
                    open_set.add(neighbor)

    return None


def _reconstruct_path(came_from, current):
    path = [current]
    while current in came_from:
        current = came_from[current]
        path.append(current)
    path.reverse()
    return path


class AStarPlannerNode:
    def __init__(self):
        rospy.init_node('astar_grid_planner')

        self.width = rospy.get_param('~grid_width', 30)
        self.height = rospy.get_param('~grid_height', 30)
        self.resolution = rospy.get_param('~resolution', 1.0)

        start = rospy.get_param('~start', [0, 0])
        goal = rospy.get_param('~goal', [29, 29])
        obstacles = rospy.get_param('~obstacles', self._default_obstacles())

        self.start = tuple(start)
        self.goal = tuple(goal)
        self.grid = GridMap(self.width, self.height, self.resolution, obstacles)

        self.path_pub = rospy.Publisher('/planned_path', Path, queue_size=1, latch=True)
        self.marker_pub = rospy.Publisher('/planning_markers', MarkerArray, queue_size=1, latch=True)

        rospy.sleep(1.0)
        self.plan_and_publish()

    def _default_obstacles(self):
        """Three full-width walls with alternating gaps -> forces a slalom path."""
        obstacles = []
        obstacles += [(x, 7) for x in range(0, 25)]
        obstacles += [(x, 14) for x in range(5, 30)]
        obstacles += [(x, 21) for x in range(0, 25)]
        return obstacles

    def plan_and_publish(self):
        rospy.loginfo("Planning path from %s to %s", self.start, self.goal)
        path = astar(self.grid, self.start, self.goal)

        if path is None:
            rospy.logwarn("No path found between start and goal!")
            return

        rospy.loginfo("Path found with %d waypoints", len(path))

        self._path_msg = self._build_path_msg(path)
        self._static_markers = self._build_marker_msg(path)

        rate_hz = 10
        rate = rospy.Rate(rate_hz)
        ticks_per_step = 3
        pause_ticks = rate_hz * 2

        idx = 0
        tick = 0
        pausing = 0

        while not rospy.is_shutdown():
            self.path_pub.publish(self._path_msg)

            markers = MarkerArray()
            markers.markers.extend(self._static_markers.markers)
            markers.markers.append(self._agent_marker(path[idx]))
            self.marker_pub.publish(markers)

            tick += 1
            if pausing > 0:
                pausing -= 1
            elif tick % ticks_per_step == 0:
                if idx < len(path) - 1:
                    idx += 1
                else:
                    idx = 0
                    pausing = pause_ticks

            rate.sleep()

    def _build_path_msg(self, path):
        msg = Path()
        msg.header.frame_id = 'map'
        msg.header.stamp = rospy.Time.now()

        for (x, y) in path:
            pose = PoseStamped()
            pose.header.frame_id = 'map'
            pose.pose.position.x = x * self.resolution
            pose.pose.position.y = y * self.resolution
            pose.pose.orientation.w = 1.0
            msg.poses.append(pose)

        return msg

    def _build_marker_msg(self, path):
        markers = MarkerArray()
        markers.markers.append(self._obstacle_marker())
        markers.markers.append(self._path_marker(path))
        markers.markers.append(self._sphere_marker(2, self.start, (0.0, 0.0, 1.0)))
        markers.markers.append(self._sphere_marker(3, self.goal, (1.0, 0.0, 0.0)))
        return markers

    def _obstacle_marker(self):
        m = Marker()
        m.header.frame_id = 'map'
        m.ns, m.id = 'obstacles', 0
        m.type, m.action = Marker.CUBE_LIST, Marker.ADD
        m.scale.x = m.scale.y = self.resolution * 0.9
        m.scale.z = 0.1
        m.color.r = m.color.g = m.color.b = 0.2
        m.color.a = 1.0
        m.pose.orientation.w = 1.0
        for (x, y) in self.grid.obstacles:
            m.points.append(Point(x * self.resolution, y * self.resolution, 0.0))
        return m

    def _path_marker(self, path):
        m = Marker()
        m.header.frame_id = 'map'
        m.ns, m.id = 'path', 1
        m.type, m.action = Marker.LINE_STRIP, Marker.ADD
        m.scale.x = 0.15
        m.color.g = 1.0
        m.color.a = 1.0
        m.pose.orientation.w = 1.0
        for (x, y) in path:
            m.points.append(Point(x * self.resolution, y * self.resolution, 0.05))
        return m

    def _sphere_marker(self, marker_id, cell, color):
        m = Marker()
        m.header.frame_id = 'map'
        m.ns, m.id = 'start_goal', marker_id
        m.type, m.action = Marker.SPHERE, Marker.ADD
        m.scale.x = m.scale.y = m.scale.z = self.resolution * 0.8
        m.color.r, m.color.g, m.color.b = color
        m.color.a = 1.0
        m.pose.position.x = cell[0] * self.resolution
        m.pose.position.y = cell[1] * self.resolution
        m.pose.position.z = 0.1
        m.pose.orientation.w = 1.0
        return m

    def _agent_marker(self, cell):
        """The 'robot' - a marker that moves along the path each tick."""
        m = Marker()
        m.header.frame_id = 'map'
        m.header.stamp = rospy.Time.now()
        m.ns, m.id = 'agent', 4
        m.type, m.action = Marker.SPHERE, Marker.ADD
        m.scale.x = m.scale.y = m.scale.z = self.resolution * 1.0
        m.color.r, m.color.g, m.color.b = (1.0, 0.6, 0.0)
        m.color.a = 1.0
        m.pose.position.x = cell[0] * self.resolution
        m.pose.position.y = cell[1] * self.resolution
        m.pose.position.z = 0.15
        m.pose.orientation.w = 1.0
        return m


if __name__ == '__main__':
    try:
        AStarPlannerNode()
        rospy.spin()
    except rospy.ROSInterruptException:
        pass
